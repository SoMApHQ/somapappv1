{
  "name": "somap-sms-worker",
  "private": true,
  "type": "module",
  "description": "SoMAp Mawasiliano SMS Worker (Cloudflare). Holds the SwalaSMS key; wallets and history in D1.",
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute somap-sms --remote --file=schema.sql",
    "console": "node tools/serve-console.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
